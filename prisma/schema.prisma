generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TENANT
}

enum BookingStatus {
  PENDING
  BOOKED
  ONGOING
  CANCELLED
  COMPLETED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) // Better Auth core requires this
  
  phone         String?
  passwordHash  String?
  avatarUrl     String?
  
  role          UserRole @default(TENANT)

  // Better Auth Admin Plugin fields
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?

  bookings      Booking[]
  tenantDetails TenantDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Booking {
  id             String        @id @default(cuid())
  hapioBookingId String        @unique
  room           Room          @relation(fields: [roomId], references: [id])
  roomId         String
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  date           DateTime
  pin            String?
  status         BookingStatus @default(PENDING)
  isPublic       Boolean       @default(false)

  thread Thread?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Thread {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id              String  @id @default(cuid())
  name            String
  rate            Int
  coverImageUrl   String?
  description     String
  images          String[] // Array of additional image URLs
  info            Json?
  stripeId        String?
  stripePrice     String?
  hapioResourceId String  @unique

  bookings Booking[]
}

model TenantDetails {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String   @unique
  stripeCustomerId String?
  transactions     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    // "hapio" | "stripe"
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?

  createdAt DateTime @default(now())
}