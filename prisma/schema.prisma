generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TENANT
}

enum BookingStatus {
  PENDING
  BOOKED
  ONGOING
  CANCELLED
  COMPLETED
}

enum PaymentProvider {
  STRIPE
  CASH
  ETRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Optional, but very helpful for querying without having to sum up transactions
enum PaymentState {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) // Better Auth core requires this

  phone        String?
  passwordHash String?
  avatarUrl    String?

  role UserRole @default(TENANT)

  // Better Auth Admin Plugin fields
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  bookings      Booking[]
  tenantDetails TenantDetails?

  accounts     Account[]
  sessions     Session[]
  transactions Transaction[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  emailLogs EmailLog[]
}

model AdminSettings {
  // Use a hardcoded string like "global" so there is only ever one row
  id String @id @default("global")

  // Business Info
  businessName String  @default("My Booking SaaS")
  supportEmail String?
  supportPhone String?

  // Payment Preferences
  enableStripe    Boolean @default(true)
  enableCash      Boolean @default(true)
  enableEtransfer Boolean @default(true)

  // E-Transfer details shown to users at checkout
  eTransferEmail        String?
  eTransferInstructions String?

  // System Controls
  maintenanceMode Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model Booking {
  id                      String        @id @default(cuid())
  hapioBookingId          String        @unique
  room                    Room          @relation(fields: [roomId], references: [id])
  roomId                  String
  user                    User          @relation(fields: [userId], references: [id])
  userId                  String
  date                    DateTime
  pin                     String?
  status                  BookingStatus @default(PENDING)
  isPublic                Boolean       @default(false)
  tempHold                DateTime?
  stripeCheckoutSessionId String?

  thread       Thread?
  paymentState PaymentState  @default(UNPAID)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Thread {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id              String   @id @default(cuid())
  name            String
  rate            Int
  capacity        Int?
  coverImageUrl   String?
  description     String
  images          String[] // Array of additional image URLs
  info            Json?
  stripeProductId String?
  stripePriceId   String?
  hapioResourceId String   @unique

  bookings Booking[]
}

model TenantDetails {
  id               String  @id @default(cuid())
  user             User    @relation(fields: [userId], references: [id])
  userId           String  @unique
  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String // "hapio" | "stripe"
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?

  createdAt DateTime @default(now())
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Transaction {
  id       String @id @default(cuid())
  amount   Int // Store in cents (e.g., $50.00 = 5000) - Stripe prefers this!
  currency String @default("cad") // or "usd"

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  // External tracking
  externalId String? // Stripe PaymentIntent ID (pi_xxx) OR E-transfer Reference Number
  receiptUrl String? // Stripe receipt URL (if applicable)

  // Useful for manual payments (Cash/E-transfer admin notes)
  notes String?

  // Relations
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@index([externalId]) // Fast lookups for Stripe webhooks
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

model EmailTemplate {
  id          String  @id @default(cuid())
  slug        String  @unique // "register", "stripe-success"
  name        String
  subject     String  // e.g., "Welcome {{name}}"
  content     String  @db.Text // ADD THIS: Stores markdown like "Hi {{name}}, your booking is confirmed!"
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model EmailLog {
  id           String  @id @default(cuid())
  templateSlug String? // Matches EmailTemplate.slug for reference

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  to      String
  from    String
  subject String

  // Store the rendered HTML exactly as sent so it can be previewed later
  html String
  text String?

  status   EmailStatus @default(SENT)
  resendId String? // Resend Message ID (for webhooks/bounces)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([templateSlug])
}
